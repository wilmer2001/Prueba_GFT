{
  "name": "saucedemo-e2e-playwright-cucumber",
  "version": "1.0.0",
  "description": "E2E Automation with Playwright + Cucumber (TypeScript) - GFT Technical Test",
  "scripts": {
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:negative": "cucumber-js --tags @negative",
    "test:critical": "cucumber-js --tags @critical"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^10.8.0",
    "@playwright/test": "^1.44.1",
    "@types/node": "^20.14.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
